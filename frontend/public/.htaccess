# Enable HTTP authorization header passing to PHP FastCGI/FPM
<IfModule mod_setenvif.c>
    SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
    SetEnvIfNoCase ^X-Deploy-Token$ "(.+)" HTTP_X_DEPLOY_TOKEN=$1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pass Authorization Header for PHP scripts
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Pass X-Deploy-Token Header
    RewriteCond %{HTTP:X-Deploy-Token} .
    RewriteRule .* - [E=HTTP_X_DEPLOY_TOKEN:%{HTTP:X-Deploy-Token}]

    # Redirect HTTP to HTTPS
    RewriteCond %{SERVER_PORT} 80
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # /api/* is served by the api/ subdirectory – do not rewrite to index.html
    # SPA fallback for all other non-file, non-directory requests
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /index.html [L]
</IfModule>

# Disable directory listings
Options -Indexes

# Block direct access to sensitive project files
<FilesMatch "(\.env|\.git|composer\.(json|lock)|package\.json)$">
    Require all denied
</FilesMatch>
